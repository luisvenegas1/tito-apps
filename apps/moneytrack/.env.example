# Copiá este archivo a .env.local y completá con tus credenciales.
# Local: valores de `pnpm db:start` (API_URL y ANON_KEY).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (opcional): clave pública VAPID. Generala con:
#   npx web-push generate-vapid-keys
# La privada va como secreto en Supabase (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=
